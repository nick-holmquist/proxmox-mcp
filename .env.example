# Proxmox connection settings
PROXMOX_HOST=https://192.168.1.100:8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=mcp-token
PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_VERIFY_SSL=false

# Optional: allowlisted directory for pve_storage_upload's file_path.
# Unset by default - pve_storage_upload is disabled (fails closed) until this
# is set, since file_path is caller-controlled and would otherwise allow
# reading arbitrary files on this host. Only set this to a directory you're
# comfortable having fully exposed to MCP tool callers.
# PROXMOX_MCP_UPLOAD_DIR=/path/to/uploads
